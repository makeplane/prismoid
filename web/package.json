{
  "name": "web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "oxlint app",
    "gen": "openapi-typescript ../docs/api/openapi.json -o app/lib/api/types.gen.ts && json2ts ../docs/api/events.schema.json -o app/lib/api/events.gen.ts --no-additionalProperties",
    "format": "oxfmt app",
    "format:check": "oxfmt --check app",
    "lint:tokens": "! grep -rnE --exclude='*.gen.ts' '(emerald|amber|rose|sky|zinc)-[0-9]|#[0-9a-fA-F]{6}|oklch\\(|rgb\\(|bg-white' app ../packages/blocks/src | grep -v -e '^app/app.css:' -e 'token-ok' || (echo 'raw palette/hex/rgb/bg-white outside app.css - use a token (mark a deliberate document-canvas exception with a token-ok comment)' && false)",
    "lint:contrast": "node scripts/contrast-audit.mjs",
    "lint:radius": "! grep -rnE '(^|[\" `])rounded([\" `]|$)|rounded-\\[|borderRadius' app ../packages/blocks/src --exclude='*.gen.ts' || (echo 'off-knob radius - the bare/arbitrary radius utilities never ride the --radius knob; use a rounded-<step> token (DESIGN.md · Radius)' && false)",
    "lint:dash": "! grep -rn --exclude='*.gen.ts' '—' app || (echo 'em dash found - the platform is em-dash-free (ADR-053 W0); write a comma, colon, middot, or hyphen instead (a deliberate test fixture spells it \\\\u2014)' && false)",
    "dev:admin": "APP_TARGET=admin react-router dev --port 5174",
    "build:admin": "APP_TARGET=admin react-router build"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@makeplane/propel": "catalog:",
    "@novnc/novnc": "catalog:",
    "@prismoid/blocks": "workspace:*",
    "@react-router/node": "catalog:",
    "isbot": "catalog:",
    "lucide-react": "catalog:",
    "mermaid": "catalog:",
    "next-themes": "catalog:",
    "openapi-fetch": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "react-router": "catalog:",
    "remark-gfm": "catalog:",
    "shiki": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "openapi-typescript": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "puppeteer-core": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
