# Exactly these keys (HANDOFF §14, URL topology). Every URL is a setting; literals live only here,
# in compose, and in ai/gateway/providers.py (audited by `just audit`).
# Copy to .env and fill the provider keys.  NEVER commit .env.

# ── database (two roles on one Postgres: the API pool and the DBOS worker) ─────
# compose publishes Postgres on PRISMOID_DB_PORT (default 5433); a moved port moves both lines below.
PRISMOID_API_DATABASE_URL=postgresql+asyncpg://prismoid:prismoid@localhost:5433/prismoid
PRISMOID_WORKER_DATABASE_URL=postgresql://prismoid:prismoid@localhost:5433/prismoid

# ── the public face (every link is constructed from this) ──────────────────────
PRISMOID_API_PUBLIC_BASE_URL=http://localhost:8100
PRISMOID_API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Where the web app lives (ADR-054): set it and the connectors OAuth callback 302s the browser
# to {web}/connectors?connected={slug}&ok=1 instead of a dead-end page. Empty = CLI-only box.
PRISMOID_API_WEB_BASE_URL=http://localhost:5173
PRISMOID_CLI_API_URL=http://localhost:8100
# Behind a reverse proxy set this to the proxy's address(es) (or "*" when the proxy is the only
# route in) so uvicorn honors X-Forwarded-For and per-IP rate limits see real clients, not the
# proxy. Empty = uvicorn's 127.0.0.1 default (ADR-031 review).
PRISMOID_API_FORWARDED_ALLOW_IPS=
# How often a live SSE/WS stream re-proves its credential + task authorization; the first failed
# proof severs the socket. The bound on how long a revoked credential keeps receiving (ADR-031).
PRISMOID_API_STREAM_REAUTH_SECONDS=10

# ── auth ──────────────────────────────────────────────────────────────────────
PRISMOID_AUTH_SIGNUP_ENABLED=true
PRISMOID_AUTH_SESSION_TTL_DAYS=30
PRISMOID_AUTH_PASSWORD_RESET_TTL_MINUTES=15
PRISMOID_AUTH_PASSWORD_RESET_MAX_PER_HOUR=5

# ── email (ADR-031: reset codes + security notices) ───────────────────────────
# console (dev default) prints the rendered email to the API stdout — that is where the
# reset code lands locally. Anything shared sets smtp — ENFORCED: with PRISMOID_ENV
# staging/prod the boot refuses console (reset codes in stdout are credentials in the logs).
PRISMOID_EMAIL_BACKEND=console
PRISMOID_EMAIL_FROM_ADDRESS="Prismoid <no-reply@plane.local>"
PRISMOID_EMAIL_SMTP_HOST=localhost
PRISMOID_EMAIL_SMTP_PORT=587
PRISMOID_EMAIL_SMTP_USERNAME=
PRISMOID_EMAIL_SMTP_PASSWORD=
PRISMOID_EMAIL_SMTP_STARTTLS=true

# ── object storage (two endpoints on purpose: internal uploads vs presigned GETs)
# compose publishes the object store (Silo) on PRISMOID_MINIO_PORT (default 9000); a moved port moves both lines below.
PRISMOID_WORKER_S3_ENDPOINT=http://localhost:9000
PRISMOID_S3_PUBLIC_ENDPOINT=http://localhost:9000
PRISMOID_WORKER_ARTIFACT_BUCKET=artifacts

# ── frames ────────────────────────────────────────────────────────────────────
PRISMOID_WORKER_EGRESS_PROXY_URL=http://egress-proxy:3128
PRISMOID_WORKER_SIGNING_KEY_PATH=.keys/verifier.ed25519
PRISMOID_WORKER_STEP_CONCURRENCY=12  # ADR-025: the long-form wave's width — 12 x 2GB frames; 8 on small hosts, 16 at >=48GB
# The egress control-plane shared secret (authenticates the worker's /allow calls to the proxy).
# Empty in dev (local, trusted); SET IN PROD so nothing but the worker can open a frame's egress.
PRISMOID_EGRESS_CONTROL_SECRET=

# ── worker durability & bounds (ADR-027) ──────────────────────────────────────
# The DBOS application version restarts adopt in-flight work by. "dev" in dev; PROD SETS the
# release git sha per deploy so a new version's boot sweep cancels the old version's ghosts.
PRISMOID_WORKER_APP_VERSION=dev
# A whole agent run's wall clock (seconds). A timeout is one infra-flavoured rung, never a dead task.
PRISMOID_WORKER_AGENT_WALL_CLOCK_S=1800

# ── the answer path (ADR-049 W0/W1) ────────────────────────────────────────────
# DBOS dequeue cadence for the task/step queues + the result joins. The 1.0s default cost every
# task ~1.5s of pure poll granularity (the surgical audit's third bucket); 0.05 ≈ ~20 cheap
# dequeue queries/s/queue on an idle instance.
PRISMOID_WORKER_QUEUE_POLL_S=0.05
# The express answerer's per-attempt wall — past it, the ladder climbs (never a silent hang).
PRISMOID_WORKER_EXPRESS_TIMEOUT_S=45
PRISMOID_WORKER_CHAT_TIMEOUT_S=150  # ADR-059: a bot reply's wall clock - past it, a SYSTEM row says so
PRISMOID_WORKER_CHAT_LEASE_S=180  # ADR-059: the reply lane's lease; a claim older than this is a dead worker's
# The catalog/routing read cache TTL (seconds; 0 disables). Bounds staleness like a hot reload;
# in-process admin writes clear it immediately.
PRISMOID_WORKER_CATALOG_CACHE_S=3.0

# ── signing (Ed25519 over the verification report, §10) ────────────────────────
# Base64 of the 32-byte Ed25519 seed. Empty in dev: the signer generates one once at
# PRISMOID_WORKER_SIGNING_KEY_PATH (0600). SET IN PROD so the key survives restarts and every
# process (worker signs, API verifies) shares it — a per-process key fails every check.
PRISMOID_SIGNING_PRIVATE_KEY=

# ── connectors (ADR-020) ──────────────────────────────────────────────────────
# Fernet key (urlsafe-base64 32 bytes); comma-separated list rotates — first encrypts, all decrypt.
# Left empty in dev: a key is generated once at PRISMOID_CONNECTORS_KEY_PATH (0600).
PRISMOID_CONNECTORS_ENCRYPTION_KEY=
PRISMOID_CONNECTORS_KEY_PATH=.connectors-key
PRISMOID_CONNECTORS_ALLOW_INSECURE_LOCALHOST=true

# ── the web door (ADR-046: `web_fetch` — always on for the agents granted it) ──
# Unlike search, this tool needs no enablement: the grant is the switch. These are its dials,
# and the defaults are the shipped policy — listed here because a security control an operator
# cannot see is one they cannot reason about.
#   CONTEXT_ANCHOR      true = fetch only URLs the task's own context names (anti-exfiltration).
#                       false is the recorded self-hoster escape hatch — free-range fetching.
#   ALLOW_INSECURE_LOCALHOST  dev only; the connectors flag's twin. NEVER true in prod.
PRISMOID_WORKER_FETCH_TIMEOUT_S=30
PRISMOID_WORKER_FETCH_MAX_BYTES=20000000
PRISMOID_WORKER_FETCH_MAX_REDIRECTS=5
PRISMOID_WORKER_FETCH_MAX_PER_STEP=12
PRISMOID_WORKER_FETCH_PAGE_CHARS=24000
PRISMOID_WORKER_FETCH_CONVERT_TIMEOUT_S=60
PRISMOID_WORKER_FETCH_CONTEXT_ANCHOR=true
PRISMOID_WORKER_FETCH_ALLOW_INSECURE_LOCALHOST=false

# ── web search (ADR-047: engines as config — the tool exists only when ENGINES is set) ─
# Ordered chain from the wire registry (ai/tools/providers/search.py: WIRES). Everything an
# engine needs arrives through four flat name=value grammars — enabling ANY registered engine
# is pure env, no code. An entry missing its requirement is skipped.
#   ENGINES        ordered CSV, e.g. "brave,anthropic,searxng"
#   KEYS           "brave=BSA…,exa=…" (one masked string; anthropic/openai fall back to the
#                  worker's provider keys above — search with zero new accounts)
#   URLS           self-host bases + endpoint overrides, e.g. "searxng=http://localhost:8888"
#   PRICES_PER_1K  ledger price overrides, e.g. "brave=5" (wire defaults otherwise)
#   MODELS         provider-native engines only, e.g. "anthropic=claude-haiku-4-5"
# Dev/self-host runs entirely on a local SearXNG: `just searxng`, then the two commented lines.
PRISMOID_SEARCH_ENGINES=
PRISMOID_SEARCH_KEYS=
PRISMOID_SEARCH_URLS=
PRISMOID_SEARCH_PRICES_PER_1K=
PRISMOID_SEARCH_MODELS=
# PRISMOID_SEARCH_ENGINES=searxng
# PRISMOID_SEARCH_URLS=searxng=http://localhost:8888

# ── routines (ADR-048: standing work — every fire mints an ordinary Task) ─────
# ENABLED is the deployment-wide kill switch: flipping it false stops the sweeps and refuses fires
# IMMEDIATELY (running tasks finish as ordinary tasks). Money defaults are the owner's
# confirmed numbers — a routine's per-run budget is REQUIRED and defaults here, never unset.
PRISMOID_ROUTINES_ENABLED=true
PRISMOID_ROUTINES_DEFAULT_BUDGET_USD=2.0
PRISMOID_ROUTINES_MIN_INTERVAL_S=300
PRISMOID_ROUTINES_DAILY_FIRE_CAP=24
PRISMOID_ROUTINES_PAUSE_AFTER_FAILURES=3
PRISMOID_ROUTINES_MAX_ACTIVE_PER_USER=50
PRISMOID_ROUTINES_MAX_CHAIN_DEPTH=3
PRISMOID_ROUTINES_MISS_GRACE_S=300
PRISMOID_ROUTINES_QUEUE_BUFFER_MAX_S=86400
PRISMOID_ROUTINES_EVENT_LAG_S=120
PRISMOID_ROUTINES_JITTER_MAX_S=120
PRISMOID_ROUTINES_FIRE_PAYLOAD_MAX_BYTES=65536

# ── steering (ADR-064: safe points) ──────────────────────────────────────────
# A mid-step pause parks its step on a gate, and a park holds a queue slot. At this many
# open pause parks across the deployment, a paused step finishes and the frontier holds it.
PRISMOID_STEERING_MAX_PAUSE_PARKS=4

# ── gates ─────────────────────────────────────────────────────────────────────
PRISMOID_QUESTION_TTL_HOURS=24

# ── providers (model strings live in the catalog; only keys live here) ─────────
PRISMOID_WORKER_ANTHROPIC_API_KEY=
PRISMOID_WORKER_OPENAI_API_KEY=
PRISMOID_WORKER_GOOGLE_API_KEY=
PRISMOID_GATEWAY_DEEPSEEK_API_KEY=
PRISMOID_GATEWAY_XAI_API_KEY=
# Any other OpenAI-compatible provider: PRISMOID_GATEWAY_<NAME>_API_KEY, in the process env or here.
# Baseten (the seeded GLM-5.3-Flash and DeepSeek-V4.1-Flash-1017 rows) reads this one.
PRISMOID_GATEWAY_BASETEN_API_KEY=
PRISMOID_GATEWAY_OPENAI_COMPAT_BASE_URL=
# Per-provider concurrent-call ceilings, PER PROCESS (ADR-024). Flat grammar: name=count,name=count
# ("default" covers the unnamed). Sized for the width-12 long-form wave; divide by replica count
# at scale. Empty = the built-in default (default=4,anthropic=12,openai=12,google=8,xai=8,local=2).
PRISMOID_GATEWAY_PROVIDER_LIMITS=

# ── observability (optional) ──────────────────────────────────────────────────
LOGFIRE_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# json: stdout carries log records only, one JSON object per line (ADR-101); console: Logfire
# prints every span. Unset: json with PRISMOID_ENV=staging or prod, console elsewhere.
PRISMOID_LOG_FORMAT=
PRISMOID_LOG_LEVEL=info

# ── policy ────────────────────────────────────────────────────────────────────
PRISMOID_FEATURE_DEFAULTS=prismoid:model-council=off
PRISMOID_PERF_BASELINE_PATH=tests/perf/baseline.json  # relative to backend/ (the service dir, ADR-007) — matches conf.py
PRISMOID_ENV=dev  # dev | test | staging | prod (PRISMOID_ENVIRONMENT also accepted); gates the email backend

# ── the scatter lane (ADR-050 W2) ──────────────────────────────────────────────
# Width and rounds bound the wide-and-deep loop (the third bound is seats reporting
# exhausted; the backstop is the Bursar). min_count is the deterministic door's threshold.
PRISMOID_WORKER_SWARM_MAX_WIDTH=8
PRISMOID_WORKER_SWARM_MAX_ROUNDS=2
PRISMOID_WORKER_SWARM_MIN_COUNT=8
PRISMOID_WORKER_SWARM_SEAT_EST_USD=0.25

# ── bot channels (ADR-056 §5): the reach doors ──────────────────────────────────────────────
# PRISMOID_CHANNELS_ENABLED=false stands every door and the minute drain down at once.
# KINDS is a CSV allowlist of channel kinds an operator has stood up (webhook needs nothing).
# PRISMOID_CHANNELS_ENABLED=true
# PRISMOID_CHANNELS_KINDS=webhook,email,telegram
# PRISMOID_CHANNELS_EMAIL_DOMAIN=bots.example.com          # empty ⇒ the email kind refuses to mint
# PRISMOID_CHANNELS_EMAIL_INBOUND_SECRET=                  # the provider webhook's header secret; set it before enabling email
# PRISMOID_CHANNELS_TELEGRAM_API_BASE=https://api.telegram.org
# PRISMOID_CHANNELS_DEFAULT_BUDGET_USD_PER_TURN=1.0
# PRISMOID_CHANNELS_DAILY_MESSAGE_CAP=100
# PRISMOID_CHANNELS_INBOUND_MAX_BYTES=65536

# ── computer use: the navigator ──────────────────────────────────────────────────────────
# NOTE: every PRISMOID_COMPUTER_USE_* setting is read ONLY from the process environment, never
# from this file (ComputerUseSettings has no env_file): export it in the shell, or put it in
# the environment of the process that runs the API and the worker. A line here sets nothing.
# PRISMOID_COMPUTER_USE_ENABLED=false stands the navigate door down; every browser ask falls
# through to the action lane or the planner as it always did. It is also the screen's kill
# switch (ADR-065): off, every lease ends, the screen sockets close and no ticket mints.
# On for the demo; default off until Phase 4 exit:
# PRISMOID_COMPUTER_USE_ENABLED=true
# PRISMOID_COMPUTER_USE_COMMAND_TIMEOUT_S=30.0
# PRISMOID_COMPUTER_USE_SNAPSHOT_WINDOW=3
# The screen (ADR-065): frame rates per socket, quality and budgets.
# PRISMOID_COMPUTER_USE_SCREEN_FPS_THUMB=1           # the rail's thumbnail
# PRISMOID_COMPUTER_USE_SCREEN_FPS_PANE=5            # an open pane
# PRISMOID_COMPUTER_USE_SCREEN_FPS_HOLDER=30         # the lease holder's own pane (30 at most)
# PRISMOID_COMPUTER_USE_SCREEN_QUALITY=60            # the screencast's JPEG quality, at most
# PRISMOID_COMPUTER_USE_SCREEN_HOLDER_QUALITY=45     # ...and at most this while the holder watches
# PRISMOID_COMPUTER_USE_SCREEN_VIEWER_BPS=300000     # each viewer's byte budget, one second deep
# PRISMOID_COMPUTER_USE_SCREEN_HOLDER_BPS=3000000    # the lease holder's own connection's budget
# PRISMOID_COMPUTER_USE_SCREEN_LINGER_S=5            # an unwatched upstream closes after this
# PRISMOID_COMPUTER_USE_SCREEN_WRITE_TIMEOUT_S=5     # a write slower than this closes the socket 4408
# PRISMOID_COMPUTER_USE_SCREEN_INPUT_PER_S=120       # input messages per socket per second
# The control lease and the CONTROL gate (ADR-065).
# PRISMOID_COMPUTER_USE_CONTROL_SILENCE_S=60         # a non-private lease ends after this with no input
# PRISMOID_COMPUTER_USE_CONTROL_PRIVATE_CAP_S=600    # a private lease's hard cap
# PRISMOID_COMPUTER_USE_CONTROL_GRACE_S=30           # after the holder's socket closes
# PRISMOID_COMPUTER_USE_CONTROL_RENEW_EVERY_S=5      # under CONTROL_SILENCE_S
# PRISMOID_COMPUTER_USE_CONTROL_WAIT_S=1200          # a CONTROL gate's TTL: under PRISMOID_MACHINES_PARK_HOLD_S
# PRISMOID_COMPUTER_USE_MASK_SETTLE_MS=300           # input dropped after a private claim
# PRISMOID_COMPUTER_USE_TICKET_TTL_S=30              # a screen ticket's life, 30 at most
# The screen door's Ed25519 key (ADR-065), "<kid>:<base64 of a 32-byte seed>": it signs the
# browser's screen tickets and sandbar's display tickets. Unlike the knobs above it is an API
# setting, read from this file too. Empty in dev (each API process mints its own); staging and
# production REFUSE to boot without it while computer use is on, since every replica and sandbar
# must share it. Generate once: echo "s1:$(openssl rand -base64 32)"
# PRISMOID_API_SCREEN_SIGNING_KEY=
# Where the API reaches sandbar's display route for a sandbar Machine's screen (empty falls back
# to PRISMOID_WORKER_SANDBAR_URL). sandbard verifies with the key's public half,
# SANDBAR_DISPLAY_KEYS (sandbar/README.md). The screen exists on sandbar only with the switch on,
# for the API and the worker alike (off: "This Machine has no live screen yet.").
# PRISMOID_API_SANDBAR_URL=http://localhost:7070
# PRISMOID_COMPUTER_USE_SANDBAR_SCREEN=true

# The sandbox browser's user agent. Off (the default): Chromium's own headless UA, and a site that
# turns away headless browsers ends the task honestly ("the site turns away automated browsers").
# On: the UA the same Chromium sends with a window. It exists to get past sites that reset the
# connection on the `HeadlessChrome` token alone (an Akamai-class headless filter) - that is passing
# a bot filter, so turn it on only if you accept that for your deployment. Nothing else is hidden:
# navigator.webdriver stays true, no CAPTCHA is solved, and an explicit bot wall still ends the task.
# The docker and sandbar drivers only: the device launches its own browser (ADR-066).
# PRISMOID_WORKER_BROWSER_HEADED_UA=false

# ── the Machine (ADR-063, Phase 1b): a task's remembered computer ───────────────────────────
# PRISMOID_MACHINES_ENABLED=false is the rollback lever: no new Machines, a frame per step again;
# Machines that hold a park still resume, and warm Machines go to sleep.
# PRISMOID_MACHINES_ENABLED=true
# PRISMOID_MACHINES_IDLE_S=600              # sleep after this long unused (dev: 60 to watch it)
# PRISMOID_MACHINES_PARK_HOLD_S=1800        # a parked Machine sleeps after this long
# PRISMOID_MACHINES_RETENTION_DAYS=14       # checkpoints are kept this long after last use
# PRISMOID_MACHINES_WORKSPACE_WARM_CAP=10         # warm Machines per workspace; at the cap the LRU idle one sleeps
# PRISMOID_MACHINES_WAIT_S=600              # how long a step waits for its Machine before an infra retry
# PRISMOID_MACHINES_PAPER=true              # a step that needs no computer (writer, organizer, operator) runs in memory, no Machine
# PRISMOID_MACHINES_PAPER_MAX_BYTES=67108864   # one paper step's files in worker memory; larger inputs take the Machine
# PRISMOID_MACHINES_WAKE_RETRY_S=180        # a natively asleep computer whose provider does not answer: retried this long, then left asleep (never destroyed)
# PRISMOID_MACHINES_CHECKPOINT_MAX_BYTES=2147483648
# PRISMOID_MACHINES_SWEEP_INTERVAL_S=30     # must divide 60
# PRISMOID_MACHINES_RECONCILE_INTERVAL_S=60 # must divide 60
# PRISMOID_MACHINES_STUCK_S=300             # STUCK_S + RECONCILE_INTERVAL_S under WAIT_S: a waiting step outlives the reconciler's fix
# PRISMOID_MACHINES_LEGACY_GRACE_S=3600     # unlabelled pre-1b frames are adopted after this
# PRISMOID_MACHINES_PRICE_PER_MIN_USD=base=0.0005,browser=0.00075,device.base=0,device.browser=0   # provisional; a base price is required; driver.profile keys price one driver
# The frame label a worker stamps and the only frames its reconciler judges. Empty = the default
# instance (which also adopts pre-1b frames); give each dev instance sharing a Docker daemon its own.
# PRISMOID_WORKER_INSTANCE=
